# Root Compose variables (optional — copy to `.env` in repo root).
# `make start-prod` also sources `frontend/.env` for NEXT_PUBLIC_* build args.
#
# --- Local production-like build (default) ---
# Leave SECURESHIP_* unset to build and tag secureship-backend:local / secureship-frontend:local.

# --- GHCR deploy (after CD push) ---
# SECURESHIP_BACKEND_IMAGE=ghcr.io/<owner>/<repo>-backend:main
# SECURESHIP_FRONTEND_IMAGE=ghcr.io/<owner>/<repo>-frontend:main

# Frontend build-time (baked into `next build` — must match browser-reachable URLs)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Auth0 SPA (admin Universal Login) — required for admin Auth0 in production images
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=
