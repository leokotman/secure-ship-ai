# Anthropic
ANTHROPIC_API_KEY=your_key_here

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# 2FA
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
