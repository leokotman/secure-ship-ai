# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS — comma-separated frontend origins (no * in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting for POST /chat (per session_id, else IP)
CHAT_RATE_LIMIT_PER_MINUTE=30

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/secureship

# 2FA
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=your_twilio_number
SMS_LOG_VERIFICATION_CODE=false

# Admin Auth
AUTH0_DOMAIN=your_domain.auth0.com
AUTH0_CLIENT_ID=your_client_id
AUTH0_CLIENT_SECRET=your_client_secret
AUTH0_AUDIENCE=your_api_audience
