# Server-side URL used by the Next.js BFF route (/api/chat).
BACKEND_API_URL=http://localhost:8000
# Optional fallback; keep only if browser-accessible config is needed elsewhere.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend URL for admin API client (browser-accessible)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Auth0 Configuration (for admin panel)
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=your_client_id
NEXT_PUBLIC_AUTH0_AUDIENCE=your_api_audience
